rules_version = '2';

// FTC Mechanism Vault — Firebase Storage rules for uploaded CAD models.
//
// The submit form uploads .glb/.gltf/.obj/.stl files to cad-models/ and saves the
// download URL on the mechanism record. Without these rules published, uploads will
// fail (default Storage rules deny all access) and the form will fall back to asking
// for a direct model link instead.
//
// Deploy with:
//
//     firebase deploy --only storage
//
// or paste into Firebase console → Storage → Rules → Publish.
//
// Storage must also be ENABLED on the project first — check
// Firebase console → Build → Storage → Get started.

service firebase.storage {
  match /b/{bucket}/o {

    match /cad-models/{fileName} {

      // Models are part of a public archive; anyone can view them.
      allow read: if true;

      // Any signed-in visitor (anonymous auth counts) may upload a new model, but:
      //   - resource == null means new objects only, so an upload cannot overwrite
      //     or silently replace someone else's existing model
      //   - the 25 MB ceiling matches the limit the submit form enforces client-side
      //   - only real mesh formats the viewer can actually load are accepted
      allow write: if request.auth != null
                   && resource == null
                   && request.resource.size < 25 * 1024 * 1024
                   && fileName.matches('.*\\.(glb|gltf|obj|stl)');
    }

    // Everything outside cad-models/ is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
